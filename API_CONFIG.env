# York Chiller Optimizer API - Deployment Configuration
# Use this file to configure the API for different environments

# ============================================================================
# ENVIRONMENT: Local Development
# ============================================================================
# Usage: python -m uvicorn api.fastapi_app:app --host 0.0.0.0 --port 7860 --reload

[local]
HOST=0.0.0.0
PORT=7860
ENVIRONMENT=development
LOG_LEVEL=INFO
RELOAD=true
WORKERS=1
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================================================
# ENVIRONMENT: Hugging Face Spaces (Docker)
# ============================================================================
# Deployed via Docker container

[huggingface_spaces]
HOST=0.0.0.0
PORT=7860
ENVIRONMENT=production
LOG_LEVEL=INFO
RELOAD=false
WORKERS=4
ALLOWED_ORIGINS=https://*.hf.space,https://*.vercel.app,*

# Model loading - for HF Spaces, store models in the 'models/' directory
# The Dockerfile expects these files:
#   - models/production_model.pkl
#   - models/scaler.pkl
#   - models/features.pkl
# If not found, API runs in DEMO mode with mock predictions

# ============================================================================
# ENVIRONMENT: Vercel (Serverless)
# ============================================================================
# For serverless deployment on Vercel

[vercel]
HOST=0.0.0.0
PORT=3000
ENVIRONMENT=production
LOG_LEVEL=WARNING
RELOAD=false
WORKERS=1
ALLOWED_ORIGINS=https://*.vercel.app,https://*.hf.space,*

# Note: Vercel requires the FastAPI app to be deployed differently.
# You'll need to use a serverless-compatible framework or lambda wrapper.

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Which origins can call the API

CORS_ALLOWED_ORIGINS=
  http://localhost:3000
  http://localhost:5173
  http://localhost:7860
  https://*.hf.space
  https://*.vercel.app
  https://*.netlify.app

CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Prediction timeout (milliseconds)
PREDICT_TIMEOUT_MS=5000

# Optimization timeout (milliseconds)
OPTIMIZE_TIMEOUT_MS=10000

# Maximum setpoints to evaluate during optimization
MAX_SETPOINTS=11

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Path to pre-trained model files
MODEL_DIR=models/
MODEL_FILE=production_model.pkl
SCALER_FILE=scaler.pkl
FEATURES_FILE=features.pkl

# Run in DEMO mode if model files not found?
DEMO_MODE=true

# ============================================================================
# LOGGING
# ============================================================================

LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=logs/api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# PERFORMANCE
# ============================================================================

# Number of worker processes
UVICORN_WORKERS=4

# Max concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Cache predictions for repeated scenarios?
ENABLE_PREDICTION_CACHE=false
CACHE_TTL_SECONDS=300

# ============================================================================
# MONITORING
# ============================================================================

# Enable detailed metrics?
METRICS_ENABLED=true

# Prometheus metrics endpoint?
METRICS_PORT=8000

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================

# Before deploying to production:
# [ ] Model files (production_model.pkl, scaler.pkl, features.pkl) prepared
# [ ] requirements.txt updated and tested
# [ ] CORS origins updated for your domain
# [ ] Logging configured for production
# [ ] Health check endpoint responds
# [ ] /predict endpoint returns valid predictions
# [ ] /optimize endpoint returns optimization data
# [ ] Frontend .env updated with correct API_URL
# [ ] Frontend sends POST requests (not GET)
# [ ] Frontend has timeout handling for slow responses
# [ ] Error handling configured with fallbacks
# [ ] HTTPS enabled (for production)
# [ ] Rate limiting configured (optional)
# [ ] Database backups configured (if used)
# [ ] Monitoring/alerting set up
# [ ] Load testing completed

# ============================================================================
# EXAMPLE: How to use this file
# ============================================================================

# 1. For local development:
#    python -m uvicorn api.fastapi_app:app --host 0.0.0.0 --port 7860 --reload
#
# 2. For Hugging Face Spaces (Docker):
#    - Copy fastapi_app.py to your Space
#    - Copy requirements.txt to your Space
#    - Copy Dockerfile to your Space
#    - Push to: git.lfs.huggingface.co/spaces/YOUR_USERNAME/YOUR_SPACE_NAME
#
# 3. For production deployment:
#    - Prepare model files in models/ directory
#    - Update CORS origins for your domain
#    - Configure logging and monitoring
#    - Use Docker deployment
#    - Set up health checks and auto-restart
#    - Configure reverse proxy (nginx/Apache) if needed

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# Problem: "405 Method Not Allowed"
# Solution: Ensure endpoint decorator is @app.post (not @app.get)
#           Ensure CORS allows POST method
#           Ensure frontend sends method: 'POST' in fetch()

# Problem: "CORS error" in browser
# Solution: Update CORS_ALLOWED_ORIGINS to include your domain
#           Ensure frontend URL matches exactly

# Problem: Slow responses (timeout)
# Solution: Increase OPTIMIZE_TIMEOUT_MS if needed
#           Optimize model prediction code
#           Use model caching or pre-warming

# Problem: Model files not found
# Solution: Check model files in models/ directory
#           Ensure filenames match exactly (case-sensitive on Linux)
#           API will run in DEMO_MODE=true anyway

# Problem: High memory usage
# Solution: Reduce UVICORN_WORKERS
#           Enable request limit / rate limiting
#           Reduce model size or use quantization

# ============================================================================
